# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Expo only exposes vars prefixed with EXPO_PUBLIC_ to the client bundle.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Gemini calls now run server-side (supabase/functions/gemini-extract and
# gemini-summary), so there is no client-side Gemini env var anymore.
# The server reads a GEMINI_API_KEY secret instead — set it with:
#   npx supabase secrets set GEMINI_API_KEY=...
