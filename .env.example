# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Expo only exposes vars prefixed with EXPO_PUBLIC_ to the client bundle.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Gemini lives in the client only for now. /services/gemini.ts is the single
# chokepoint so this can move server-side (Cloud Run) without app changes.
EXPO_PUBLIC_GEMINI_API_KEY=
