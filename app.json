{
  "expo": {
    "name": "Teftera",
    "slug": "teftera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "teftera",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121316",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teftera.app"
    },
    "android": {
      "package": "com.teftera.app",
      "adaptiveIcon": {
        "backgroundColor": "#121316",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121316",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Teftera accesses your photos so you can attach receipt images."
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Teftera използва камерата за сканиране на бележки."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bcee3c0e-1a24-4576-88eb-12cd0f089bb5"
      }
    },
    "owner": "radoych"
  }
}
